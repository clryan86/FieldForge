+def _region_pack_inventory(archive):
+    """Validate fixed archive structure before any extraction or publication."""
+    entries = archive.infolist()
+    names = [item.filename for item in entries]
+    if len(entries) not in (4, 5) or len(names) != len(set(names)) or not set(names) <= PACK_MEMBERS:
+        raise ValueError('Prepared region ZIP has an unsupported or duplicate member list.')
+    total = 0
+    for item in entries:
+        mode = item.external_attr >> 16
+        if (item.is_dir() or item.flag_bits & 1
+                or stat.S_IFMT(mode) not in (0, stat.S_IFREG)
+                or item.compress_type not in (zipfile.ZIP_STORED, zipfile.ZIP_DEFLATED)
+                or item.file_size < 1):
+            raise ValueError('Prepared region ZIP contains unsupported member metadata.')
+        total += item.file_size
+        if total > PACK_MAX_EXPANDED:
+            raise ValueError('Prepared region ZIP exceeds the expanded byte budget.')
+    manifest = archive.getinfo(MANIFEST)
+    if manifest.file_size > MAX_MANIFEST:
+        raise ValueError('Prepared region manifest exceeds its size budget.')
+    try:
+        data = json.loads(archive.read(MANIFEST).decode('utf-8'), object_pairs_hook=_unique,
+                          parse_constant=lambda _: (_ for _ in ()).throw(
+                              ValueError('Non-finite region metadata.')))
+    except (UnicodeError, json.JSONDecodeError, TypeError, RecursionError) as exc:
+        raise ValueError('Malformed prepared region manifest.') from exc
+    if (not isinstance(data, dict) or data.get('format') != FORMAT
+            or data.get('state') != 'complete'
+            or re.fullmatch('[0-9a-f]{32}', data.get('id', '')) is None):
+        raise ValueError('Prepared region ZIP has an unsupported manifest.')
+    road = data.get('roads')
+    files = data.get('files')
+    if not isinstance(road, dict) or not isinstance(files, dict):
+        raise ValueError('Prepared region ZIP manifest is incomplete.')
+    required = {MANIFEST, FILES['source'], FILES['map'], FILES['rights']}
+    if road.get('state') == 'prepared-experimental':
+        required.add(FILES['roads'])
+    if set(names) != required:
+        raise ValueError('Prepared region ZIP members do not match its readiness manifest.')
+    return entries, data, total
+
+
+def import_region_pack(pack_path, library, *, cancel=None, progress=None):
+    """Import a prepared region ZIP into a new, fully verified library folder."""
+    library = _directory(library)
+    pack_path = Path(pack_path).expanduser().absolute()
+    if pack_path.suffix.casefold() != '.zip':
+        raise ValueError('Choose a prepared FieldForge region .zip file.')
+    before = signature(pack_path)
+    if not 1 <= before[2] <= PACK_MAX_COMPRESSED:
+        raise ValueError('Prepared region ZIP exceeds the compressed byte budget.')
+    _check(cancel)
+    with zipfile.ZipFile(pack_path) as archive:
+        entries, manifest, expanded = _region_pack_inventory(archive)
+        if shutil.disk_usage(library).free < expanded + RESERVE:
+            raise ValueError('Not enough free storage for this prepared region and reserve.')
+        folder = library / ('region-' + manifest['id'])
+        if folder.exists() or folder.is_symlink():
+            raise ValueError('This prepared region identity is already present in the selected library.')
+        folder.mkdir(mode=0o700)
+        owned = _identity(folder)
+        complete = False
+        try:
+            _new_bytes(folder / MARKER,
+                       b'Incomplete prepared-region import. Do not open as installed data.\n')
+            copied = 0
+            for item in entries:
+                _check(cancel)
+                target = folder / item.filename
+                count = 0
+                with archive.open(item) as source, target.open('xb') as output:
+                    while block := source.read(CHUNK):
+                        _check(cancel)
+                        count += len(block)
+                        copied += len(block)
+                        if count > item.file_size or copied > expanded:
+                            raise ValueError('Prepared region ZIP expanded beyond its declared size.')
+                        output.write(block)
+                        _scaled(progress, 0, 70)(copied, expanded)
+                    output.flush()
+                    os.fsync(output.fileno())
+                if count != item.file_size:
+                    raise ValueError('Prepared region ZIP member was truncated during extraction.')
+            if copied != expanded or signature(pack_path) != before:
+                raise ValueError('Prepared region ZIP changed during import.')
+            result = _verify_region(folder, cancel=cancel,
+                                    progress=_scaled(progress, 70, 99), staging=True)
+            _check(cancel)
+            (folder / MARKER).unlink()
+            _load_manifest(folder)
+            complete = True
+            if progress:
+                progress(100, 100)
+            return result
+        finally:
+            if (not complete and folder.is_dir() and not folder.is_symlink()
+                    and _identity(folder) == owned):
+                shutil.rmtree(folder, ignore_errors=True)
+
