+def make_prepared_pack(region, path):
+    import zipfile
+    with zipfile.ZipFile(path, 'w', compression=zipfile.ZIP_DEFLATED, allowZip64=True) as archive:
+        for item in sorted(region.folder.iterdir(), key=lambda p: p.name):
+            archive.write(item, item.name)
+    return path
+
+
+def test_import_prepared_pack_roundtrip_full_verification(tmp_path):
+    source = tmp_path / 'source.osm.pbf'
+    source.write_bytes(diamond())
+    built_library = tmp_path / 'built'
+    built_library.mkdir()
+    built = ri.install_region(source, built_library, 'Prepared fixture', try_roads=True)
+    pack = make_prepared_pack(built, tmp_path / 'prepared.zip')
+    before = hashlib.sha256(pack.read_bytes()).hexdigest()
+    library = tmp_path / 'imported'
+    library.mkdir()
+    imported = ri.import_region_pack(pack, library)
+    assert imported.manifest == built.manifest
+    assert imported.folder.parent == library
+    assert imported.index.metadata['source_sha256'] == built.index.metadata['source_sha256']
+    assert imported.road_pack is not None and imported.road_pack.metadata['nodes'] == built.road_pack.metadata['nodes']
+    assert (imported.folder / ri.FILES['source']).read_bytes() == source.read_bytes()
+    assert not (imported.folder / ri.MARKER).exists()
+    assert hashlib.sha256(pack.read_bytes()).hexdigest() == before
+    assert ri.verify_region(imported.folder).manifest == built.manifest
+
+
+def test_import_prepared_pack_refuses_existing_identity_without_changes(tmp_path):
+    source = tmp_path / 'source.osm.pbf'
+    source.write_bytes(diamond())
+    build = tmp_path / 'build'; build.mkdir()
+    prepared = ri.install_region(source, build, 'Prepared fixture')
+    pack = make_prepared_pack(prepared, tmp_path / 'prepared.zip')
+    library = tmp_path / 'library'; library.mkdir()
+    first = ri.import_region_pack(pack, library)
+    before = {p.name: p.read_bytes() for p in first.folder.iterdir()}
+    with pytest.raises(ValueError, match='already present'):
+        ri.import_region_pack(pack, library)
+    assert before == {p.name: p.read_bytes() for p in first.folder.iterdir()}
+
+
+def test_import_prepared_pack_rejects_extra_member_before_publication(tmp_path):
+    source = tmp_path / 'source.osm.pbf'; source.write_bytes(diamond())
+    build = tmp_path / 'build'; build.mkdir()
+    prepared = ri.install_region(source, build, 'Prepared fixture')
+    pack = make_prepared_pack(prepared, tmp_path / 'prepared.zip')
+    import zipfile
+    with zipfile.ZipFile(pack, 'a') as archive:
+        archive.writestr('../escape.txt', b'no')
