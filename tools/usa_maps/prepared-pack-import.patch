+def test_import_prepared_pack_rejects_changed_member_crc_and_cleans(tmp_path):
+    source = tmp_path / 'source.osm.pbf'; source.write_bytes(diamond())
+    build = tmp_path / 'build'; build.mkdir()
+    prepared = ri.install_region(source, build, 'Prepared fixture')
+    pack = make_prepared_pack(prepared, tmp_path / 'prepared.zip')
+    raw = bytearray(pack.read_bytes())
+    raw[len(raw)//2] ^= 1
+    pack.write_bytes(raw)
+    library = tmp_path / 'library'; library.mkdir()
+    with pytest.raises((ValueError, OSError, zipfile.BadZipFile)):
+        ri.import_region_pack(pack, library)
+    assert not list(library.iterdir())
