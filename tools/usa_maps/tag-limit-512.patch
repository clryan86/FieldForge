+def test_valid_entity_with_more_than_128_tags_is_supported_but_still_bounded(monkeypatch):
+    extra = tuple((f"extra-{i}", f"value-{i}") for i in range(127))
+    strings = ("", "highway", "residential", "name", "Map Street") + tuple(
+        value for pair in extra for value in pair
+    )
+    keys = [1, 3] + [5 + i * 2 for i in range(len(extra))]
+    vals = [2, 4] + [6 + i * 2 for i in range(len(extra))]
+    group = binary(1, node(1, -70, 40)) + binary(1, node(2, -69.999, 40.001))
+    group += binary(3, way(keys=keys, vals=vals))
+    result = osm.parse_street_source(header() + primitive(group, strings))
+    road = result.features[0]
+    assert road.name == "Map Street" and road.kind == "highway=residential"
+    monkeypatch.setattr(osm, "MAX_TAGS", 128)
+    with pytest.raises(ValueError, match="tags"):
+        osm.parse_street_source(header() + primitive(group, strings))
+
 def test_dense_empty_tags_and_unpacked_values():
